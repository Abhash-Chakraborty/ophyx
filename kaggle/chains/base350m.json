{
 "enabled": false,
 "script": "train/run_sequence.py",
 "include": [
  "train/pretrain.py"
 ],
 "accel": "tpu",
 "timeout": 32400,
 "kernels": [
  "ophyx-train-base350m-a",
  "ophyx-train-base350m-b"
 ],
 "datasets": [
  "ophyx-keys"
 ],
 "kernel_sources": [
  "ophyx-tokens-v1",
  "ophyx-tokens-v2"
 ],
 "config": {
  "vocab": 32768,
  "seq": 2048,
  "eos_id": 0,
  "optimizer": "muon",
  "attention": "xla",
  "remat": "full",
  "loss_chunk": 512,
  "decay_frac": 0.15,
  "min_lr_frac": 0.05,
  "budget_s": 30600,
  "margin_s": 1500,
  "ckpt_every_s": 3600,
  "log_every": 50,
  "eval_every": 500,
  "export_hf": true,
  "wandb": null,
  "hf_ckpt_repo": "abhash-chakraborty/ophyx-runs",
  "data": {
   "buckets": {
    "stack_edu_a": {
     "glob": "/kaggle/input/**/tokens/stack_edu_a/train/*.bin",
     "weight": 0.13
    },
    "stack_edu_b": {
     "glob": "/kaggle/input/**/tokens/stack_edu_b/train/*.bin",
     "weight": 0.24
    },
    "github_a": {
     "glob": "/kaggle/input/**/tokens/github_a/train/*.bin",
     "weight": 0.17
    },
    "github_b": {
     "glob": "/kaggle/input/**/tokens/github_b/train/*.bin",
     "weight": 0.25
    },
    "oc_synthetic_qa": {
     "glob": "/kaggle/input/**/tokens/oc_synthetic_qa/train/*.bin",
     "weight": 0.08
    },
    "oc_synthetic_code_snippet": {
     "glob": "/kaggle/input/**/tokens/oc_synthetic_code_snippet/train/*.bin",
     "weight": 0.025
    },
    "oc_algorithmic_corpus": {
     "glob": "/kaggle/input/**/tokens/oc_algorithmic_corpus/train/*.bin",
     "weight": 0.02
    },
    "fineweb_edu": {
     "glob": "/kaggle/input/**/tokens/fineweb_edu/train/*.bin",
     "weight": 0.06
    },
    "cpython_lib": {
     "glob": "/kaggle/input/**/tokens/cpython_lib/train/*.bin",
     "weight": 0.001
    },
    "python_docs": {
     "glob": "/kaggle/input/**/tokens/python_docs/train/*.bin",
     "weight": 0.001
    }
   },
   "val_glob": "/kaggle/input/**/tokens/stack_edu_a/val/*.bin",
   "phases": [
    {
     "until": 0.85,
     "weights": {
      "stack_edu_a": 0.13,
      "stack_edu_b": 0.24,
      "github_a": 0.17,
      "github_b": 0.25,
      "oc_synthetic_qa": 0.08,
      "oc_synthetic_code_snippet": 0.025,
      "oc_algorithmic_corpus": 0.02,
      "fineweb_edu": 0.06,
      "cpython_lib": 0.001,
      "python_docs": 0.001
     }
    },
    {
     "until": 1.0,
     "weights": {
      "stack_edu_a": 0.25,
      "stack_edu_b": 0.08,
      "github_a": 0.3,
      "github_b": 0.05,
      "oc_synthetic_qa": 0.1,
      "oc_synthetic_code_snippet": 0.07,
      "oc_algorithmic_corpus": 0.06,
      "fineweb_edu": 0.03,
      "cpython_lib": 0.007,
      "python_docs": 0.007
     }
    }
   ],
   "fim_rate": 0.5,
   "fim_buckets": [
    "stack_edu_a",
    "stack_edu_b",
    "github_a",
    "github_b",
    "oc_synthetic_code_snippet",
    "cpython_lib"
   ]
  },
  "model": "base",
  "micro_batch": 8,
  "batch_tokens": 524288,
  "total_tokens": 12000000000,
  "lr": 0.003,
  "warmup_tokens": 500000000,
  "run_name": "base350m-v1",
  "session_name": "base350m",
  "library": true,
  "runs": [
   {
    "run_name": "nano125m-sft-v1",
    "model": "nano",
    "micro_batch": 16,
    "batch_tokens": 262144,
    "total_tokens": 600000000,
    "lr": 0.0005,
    "warmup_tokens": 30000000,
    "decay_frac": 0.9,
    "min_lr_frac": 0.1,
    "eval_every": 200,
    "init_from": "hf://abhash-chakraborty/ophyx-runs/nano125m-v1/latest",
    "hf_data": {
     "repo": "abhash-chakraborty/ophyx-data",
     "dir": "/kaggle/tmp/hf_data",
     "patterns": [
      "v1/sft/*/tokens/*/*.bin",
      "v1/sft/*/mask/*/*.bin"
     ]
    },
    "data": {
     "buckets": {
      "sft_stage1": {
       "glob": "/kaggle/tmp/hf_data/v1/sft/stage1/tokens/train/*.bin",
       "mask_glob": "/kaggle/tmp/hf_data/v1/sft/stage1/mask/train/*.bin",
       "aligned": true,
       "weight": 1.0
      },
      "sft_stage2": {
       "glob": "/kaggle/tmp/hf_data/v1/sft/stage2/tokens/train/*.bin",
       "mask_glob": "/kaggle/tmp/hf_data/v1/sft/stage2/mask/train/*.bin",
       "aligned": true,
       "weight": 0.0
      }
     },
     "val_glob": "/kaggle/tmp/hf_data/v1/sft/*/tokens/val/*.bin",
     "val_mask_glob": "/kaggle/tmp/hf_data/v1/sft/*/mask/val/*.bin",
     "phases": [
      {
       "until": 0.65,
       "weights": {
        "sft_stage1": 1.0,
        "sft_stage2": 0.0
       }
      },
      {
       "until": 1.0,
       "weights": {
        "sft_stage1": 0.25,
        "sft_stage2": 0.75
       }
      }
     ]
    }
   },
   {}
  ]
 }
}
