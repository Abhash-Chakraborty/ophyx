[Unit]
Description=ophyx training-chain watchdog (backup for the GitHub Actions schedule)

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/Experiment
Environment=KAGGLE_BIN=/home/ubuntu/.local/bin/kaggle
Environment=PATH=/home/ubuntu/.local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/.local/bin/uv run -q --no-project --with huggingface_hub python -I /home/ubuntu/Experiment/kaggle/watchdog.py
Nice=19
CPUQuota=20%
MemoryMax=300M
TimeoutStartSec=600
