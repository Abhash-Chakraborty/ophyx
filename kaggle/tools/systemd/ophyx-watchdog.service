[Unit]
# Install: copy both files to ~/.config/systemd/user/, then systemctl --user enable --now ophyx-watchdog.timer
# (%h is your home directory; the repo is expected at ~/Experiment).
Description=ophyx training-chain watchdog (backup for the GitHub Actions schedule)

[Service]
Type=oneshot
WorkingDirectory=%h/Experiment
Environment=KAGGLE_BIN=%h/.local/bin/kaggle
Environment=PATH=%h/.local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/uv run -q --no-project --with huggingface_hub python -I %h/Experiment/kaggle/watchdog.py
Nice=19
CPUQuota=20%
MemoryMax=300M
TimeoutStartSec=600
